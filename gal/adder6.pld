Name     ADDER6;
PartNo   10;
Date     2026-03-10;
Revision 01;
Designer cpuai2;
Company  ;
Assembly ;
Location ;
Device   g22v10;

/* ============================================================ */
/*  6-bit adder with carry in/out                               */
/*  S = A + B + CIN                                             */
/*                                                              */
/*  Carry chain split into 3 x 2-bit segments via pin feedback  */
/*  to stay within GAL22V10 product term limits.                */
/*  C1 and C3 are routed through output pins so that later      */
/*  equations see them as simple inputs (feedback path).         */
/* ============================================================ */

/* Input pins */
PIN 1  = CIN;
PIN 2  = A0;
PIN 3  = A1;
PIN 4  = A2;
PIN 5  = A3;
PIN 6  = A4;
PIN 7  = A5;
PIN 8  = B0;
PIN 9  = B1;
PIN 10 = B2;
PIN 11 = B3;
PIN 13 = B4;
PIN 14 = B5;

/* Output pins - assigned to fit product term budgets            */
/*   S0,S2,S4 need  4 PT (simple XOR, carry is pin input)       */
/*   S1,S3,S5 need 12 PT (XOR with 2-bit expanded carry)        */
/*   C1,C3    need  7 PT (carry with 2-bit expansion)            */
/*   COUT     needs 7 PT (carry with 2-bit expansion)            */
PIN 23 = S4;    /*  8 product terms,  need  4 */
PIN 22 = S0;    /* 10 product terms,  need  4 */
PIN 21 = C3;    /* 12 product terms,  need  7 */
PIN 20 = S5;    /* 14 product terms,  need 12 */
PIN 19 = S1;    /* 16 product terms,  need 12 */
PIN 18 = S3;    /* 16 product terms,  need 12 */
PIN 17 = C1;    /* 14 product terms,  need  7 */
PIN 16 = COUT;  /* 12 product terms,  need  7 */
PIN 15 = S2;    /* 10 product terms,  need  4 */

/* ---- Segment 0: bits 0-1, carry in = CIN ---- */

/* Bit 0 full adder */
S0 = A0 $ B0 $ CIN;

/* Carry out of bit 0 (intermediate, expanded into C1 and S1) */
C0 = A0 & B0 # A0 & CIN # B0 & CIN;

/* Bit 1 full adder */
S1 = A1 $ B1 $ C0;

/* Carry out of bit 1 (output pin, used as feedback input) */
C1 = A1 & B1 # A1 & C0 # B1 & C0;

/* ---- Segment 1: bits 2-3, carry in = C1 (pin feedback) ---- */

/* Bit 2 full adder */
S2 = A2 $ B2 $ C1;

/* Carry out of bit 2 (intermediate, expanded into C3 and S3) */
C2 = A2 & B2 # A2 & C1 # B2 & C1;

/* Bit 3 full adder */
S3 = A3 $ B3 $ C2;

/* Carry out of bit 3 (output pin, used as feedback input) */
C3 = A3 & B3 # A3 & C2 # B3 & C2;

/* ---- Segment 2: bits 4-5, carry in = C3 (pin feedback) ---- */

/* Bit 4 full adder */
S4 = A4 $ B4 $ C3;

/* Carry out of bit 4 (intermediate, expanded into COUT and S5) */
C4 = A4 & B4 # A4 & C3 # B4 & C3;

/* Bit 5 full adder */
S5 = A5 $ B5 $ C4;

/* Carry out of bit 5 */
COUT = A5 & B5 # A5 & C4 # B5 & C4;
